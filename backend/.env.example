# Cấu hình môi trường AI Agent Tự động hóa lưới điện phân phối
# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình đa phương thức (Vision + Text)
GEMINI_MODEL=gemini-1.5-flash

# Ngôn ngữ mặc định (vi: Tiếng Việt, zh-CN: Tiếng Trung)
DEFAULT_LANGUAGE=vi

# Đường dẫn tài liệu giáo trình duy nhất
TEXTBOOK_PDF_PATH=backend/knowledge/course_textbook.pdf

# Cổng Backend FastAPI
HOST=127.0.0.1
PORT=8000

# SQLite Database
DATABASE_URL=sqlite+aiosqlite:///./agent_app.db
